# ============================================================
# GameFolio — environment configuration
# ============================================================
# Copy this file to .env and fill in the values you need.
# (On a fresh clone, `pnpm db:push` / `db:generate` create .env for you
#  from this file automatically — see scripts/ensure-env.mjs.)
# NEVER commit your real .env (it is gitignored).

# ------------------------------------------------------------
# Database — SQLite (local dev) or PostgreSQL (production)
# ------------------------------------------------------------
# SQLite path is resolved relative to prisma/schema.prisma, so this creates
# prisma/dev.db. Use a PostgreSQL URL in production.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# Auth (optional — for accounts & cloud profiles)
# ------------------------------------------------------------
# Required only if you enable accounts. Generate a 32+ char random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET="generate-a-32+-char-random-secret"

# ------------------------------------------------------------
# Public base URL (used for share links + og:image)
# ------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:12000"

# ------------------------------------------------------------
# AI generation (optional — app works fully without a key in mock mode)
# ------------------------------------------------------------
# AI_PROVIDER selects the provider:
#   - mock      : offline, deterministic (DEFAULT — no key needed, safe for dev)
#   - gemini    : REAL AI via Google Gemini (quasi gratuit, free tier, NO credit
#                 card required). Recommended to try real generation.
#                 Create a key: https://aistudio.google.com/app/apikey
#                 Vars expected by the code: GEMINI_API_KEY (alias GOOGLE_API_KEY)
#   - anthropic : REAL AI via Claude. Requires a paid Anthropic key.
#                 Var expected by the code: ANTHROPIC_API_KEY
#
# To enable Gemini: set AI_PROVIDER="gemini" and paste your key below.
AI_PROVIDER="mock"
GEMINI_API_KEY="your_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"
ANTHROPIC_API_KEY="your_api_key_here"
ANTHROPIC_MODEL=""

# ------------------------------------------------------------
# Export (optional) — override the isolated render URL host, or point Playwright
# at a specific Chromium binary when the bundled one isn't available.
# ------------------------------------------------------------
# EXPORT_BASE_URL=""
# PLAYWRIGHT_EXECUTABLE_PATH="/usr/bin/chromium"
