# Database — SQLite (local dev) or PostgreSQL (production)
DATABASE_URL="file:./dev.db"

# Auth (optional, for accounts — v2)
AUTH_SECRET="generate-a-32+-char-random-secret"

# Public base URL (used for share links + og:image)
NEXT_PUBLIC_BASE_URL="http://localhost:12000"

# AI generation (optional — app works without it, only text generation is disabled)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Export (optional) — override the isolated render URL host, or point Playwright
# at a specific Chromium binary when the bundled one isn't available.
# EXPORT_BASE_URL=""
# PLAYWRIGHT_EXECUTABLE_PATH=""
