# Hoist Prisma packages to the root node_modules so the Prisma generator's
# findPrismaClientDir() can resolve @prisma/client (pnpm's strict node_modules
# layout otherwise makes the CLI + client resolve as siblings under .pnpm,
# which trips Prisma's auto-install-on-generate). This is a documented pnpm +
# Prisma workaround. Production deployments (npm/yarn) don't need it.
public-hoist-pattern[]=*prisma*
